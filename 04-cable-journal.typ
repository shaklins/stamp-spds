#import "template/template.typ": spds-frame

#set page(paper: "a3", flipped: true)

#show: spds-frame.with(format-table:"Форма 3", name-paper:"Кабельный журнал", format:"A3")

// Ширина колонок, мм. Сумма = 395 mm — это вся внутренняя ширина рамки
// листа A3 в ландшафтной ориентации: 420 - 20 (левая рамка) - 5 (правая рамка).
// Порядок совпадает с порядком колонок формы кабельного журнала.
#let cable-journal-columns = (
  30mm,  // Маркировка кабеля
  35mm,  // Трасса — Начало
  35mm,  // Трасса — Конец
  45mm,  // Кабель, провод — Марка
  40mm,  // Кабель, провод — Кол-во, сечение, напряж.
  20mm,  // Кабель, провод — Длина, м
  40mm,  // Проход трассы — Обозначение
  130mm, // Проход трассы — Характеристики
  20mm,  // Проход трассы — Длина, м
)

#let cable-journal-form1(..rows) = {
  table(
    columns: cable-journal-columns,
    align: center + horizon,
    stroke: 0.5pt,
    
    // Заголовок таблицы (Шапка)
    table.header(
      table.cell(rowspan: 2)[Маркировка кабеля],
      table.cell(colspan: 2)[Трасса], // Пустая ячейка для объединения (Начало/Конец)
      table.cell(colspan: 3)[Кабель, провод],// Пустая ячейка для объединения (Марка/Кол-во/Длина)
      table.cell(colspan: 3)[Проход трассы (способ прокладки)],// Пустая ячейка для объединения (Марка/Кол-во/Длина)
      
      // Второй уровень шапки
      [Начало], [Конец],
      [Марка], [Кол-во, сечение, напряж.], [Длина, м],
      [Обозначение], [Характеристики], [Длина, м],
    ),
    
    // Пример наполнения
    ..rows
  )
}

#let cable-rows = csv("data/cable-journal.csv", row-type: array).slice(1)

// pad: left -10mm + right -5mm — выводим таблицу на всю ширину рамки (395 mm),
// top -15mm — прижимаем к верхней линии рамки.
#pad(left: -10mm, right: -5mm, top: -15mm)[
  #cable-journal-form1(
    ..cable-rows.flatten()
  )
]
