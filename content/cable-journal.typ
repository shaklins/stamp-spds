#let cable-journal-form1(..rows) = {
  table(
    columns: (25mm, 50mm,50mm,35mm,35mm,25mm,50mm,100mm,25mm),
    align: center + horizon,
    stroke: 0.5pt,
    
    // Заголовок таблицы (Шапка)
    table.header(
      table.cell(rowspan: 2)[Маркировка кабеля],
      table.cell(colspan: 2)[Трасса], // Пустая ячейка для объединения (Начало/Конец)
      table.cell(colspan: 3)[Кабель, провод],// Пустая ячейка для объединения (Марка/Кол-во/Длина)
      table.cell(colspan: 3)[Проход трассы (способ прокладки)],// Пустая ячейка для объединения (Марка/Кол-во/Длина)
      
      // Второй уровень шапки
      [Начало], [Конец],
      [Марка], [Кол-во, сечение, напряж.], [Длина, м],
      [Обозначение], [Характеристики], [Длина, м],
    ),
    
    // Пример наполнения
    ..rows
  )
}

#pad(left: -10mm, top: -15mm)[
#cable-journal-form1(
  ..([W1], [ЩО-1], [М1], [ВВГнг], [3х2.5-0.66], [25], [], [], [],)*40
)
]
